# CyberSpectra needs no secrets and makes no network calls.
# Optional overrides (copy to .env and export, or set in your shell):

# SQLite database used by the dashboard (default: data/monitoring.db)
CYBERSPECTRA_DB=data/monitoring.db

# Append-only audit log (default: logs/audit.log)
CYBERSPECTRA_AUDIT_LOG=logs/audit.log
